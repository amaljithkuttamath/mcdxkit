# Copy to .env in the directory where you launch MCDXKit. Never commit keys.
# Browser-saved settings > process environment > .env.
OPENROUTER_API_KEY=
# Choose models in Documents > Connect services. No Ollama is needed.
# Optional answer model override for a workspace with no saved selection:
# MCDXKIT_OPENROUTER_MODEL=provider/model:free

# Advanced: only for a separately managed RAGFlow installation.
# MCDXKIT_RAGFLOW_URL=http://127.0.0.1:9380
# MCDXKIT_RAGFLOW_API_KEY_FILE=.secrets/ragflow-api-key
# OPENROUTER_API_KEY_FILE=.secrets/openrouter-api-key
# MCDXKIT_RAGFLOW_EMBEDDING_MODEL=provider/model:free@mcdxkit@OpenRouter
# MCDXKIT_RAGFLOW_RERANK_MODEL=
