# Copy to .env locally. Never commit actual keys or generated deployment configs.
MCDXKIT_RAGFLOW_URL=http://127.0.0.1:9380
# Optional host-process secret files; omit when using browser setup.
# MCDXKIT_RAGFLOW_API_KEY_FILE=.secrets/ragflow-api-key
# OPENROUTER_API_KEY_FILE=.secrets/openrouter-api-key
# Install/configure this local provider in RAGFlow first; use its exact name.
MCDXKIT_RAGFLOW_EMBEDDING_MODEL=bge-m3@Ollama
# Optional: an installed RAGFlow reranker identifier.
MCDXKIT_RAGFLOW_RERANK_MODEL=
# Choose a currently available free model in OpenRouter. Random/paid routers are rejected.
MCDXKIT_OPENROUTER_MODEL=
