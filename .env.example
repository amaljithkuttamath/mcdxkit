# Local Docker. For a cloud host set both values to your real HTTPS domain.
MCDXKIT_PUBLIC_URL=http://127.0.0.1:8765
MCDXKIT_PORT=8765
MCDXKIT_DOMAIN=localhost

# Optional: set an immutable sha tag when using compose.registry.yaml.
# MCDXKIT_IMAGE=ghcr.io/amaljithkuttamath/mcdxkit:sha-<full-commit-sha>
# Access tokens belong in .secrets/access-token, created by setup_deploy.py.
# Never commit deployment credentials or private template paths.

# Optional document AI key. MCDXKit reads .env in the launch directory.
# Browser-saved settings > process environment > .env. Never add real keys here.
OPENROUTER_API_KEY=
# Choose answer/search models in Documents > Connect services.
# MCDXKIT_OPENROUTER_MODEL=provider/model:free
